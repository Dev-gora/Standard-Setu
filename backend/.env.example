# ╔══════════════════════════════════════════════════════════════╗
# ║  Standard Setu (SIH26108) — Environment Variables            ║
# ╚══════════════════════════════════════════════════════════════╝
# Copy this file to .env:  cp .env.example .env
# The app works fully WITHOUT any LLM key (rule-based fallbacks).

# ── Option 1: Ollama (free, local, offline) ──
# Install: https://ollama.com   Then: ollama pull llama3.1:8b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Option 2: Google Gemini free tier (no credit card needed) ──
# Get key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSyAmjleBXLPaAYu_qdt22YekALAKyin-lf8
# GEMINI_MODEL=gemini-1.5-flash

# ── Option 3: OpenAI (paid — skip if using free options) ──
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# ── Option 4: Anthropic (paid) ──
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Embeddings (always free, runs locally) ──
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── App ──
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=true
